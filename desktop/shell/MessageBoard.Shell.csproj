<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>MessageBoard.Shell</AssemblyName>
    <RootNamespace>MessageBoard.Shell</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Message Board</Product>
    <Description>Message Board · 留言板 桌面外壳（WPF + WebView2）</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 项目 logo（与站点 favicon 同一份矢量母版）：exe 图标 / 任务栏 / 窗口图标 -->
    <ApplicationIcon>..\..\web\assets\message-board-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
