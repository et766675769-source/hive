<Window x:Class="Hive.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="蜂群 HIVE" Height="840" Width="1320"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <!-- 全部圆角 -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="9"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="9"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,8" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="276" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ── 左侧栏 ─────────────────────────────────────── -->
    <DockPanel Grid.Column="0" Background="{DynamicResource Surface2}">
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
        <DockPanel>
          <!-- 右上角：设置 -->
          <Button x:Name="AppSettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                  Content="⚙" Click="OnOpenAppSettings" ToolTip="设置（开机启动 / 存储位置 / 全局 API / 主题）"
                  VerticalAlignment="Top" />
          <StackPanel Orientation="Horizontal">
            <Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="蜂群 HIVE" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink}" />
              <TextBlock Text="AI 员工面板" FontSize="11.5" Foreground="{DynamicResource Ink3}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 左下角：只保留这三个 -->
      <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
        <Button x:Name="AddProjectButton" Content="新建项目" Click="OnAddProject" Margin="0,0,0,6" />
        <Button x:Name="AddDepartmentButton" Content="新建部门" Click="OnAddDepartment" Margin="0,0,0,6" />
        <Button x:Name="AddEmployeeButton" Content="添加员工" Click="OnAddEmployee" />
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,10,10,0">
        <StackPanel>
          <TextBlock Text="项目" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                     Margin="6,0,0,6" />
          <ItemsControl x:Name="ProjectList" />
          <TextBlock x:Name="ProjectEmpty" Text="还没有项目" FontSize="12" Foreground="{DynamicResource Ink3}"
                     Margin="10,0,0,12" />

          <TextBlock Text="部门" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                     Margin="6,8,0,6" />
          <ItemsControl x:Name="DepartmentList" />
          <Button x:Name="OrphanHeader" Content="未分配部门" HorizontalContentAlignment="Left"
                  Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource Ink3}" Click="OnToggleOrphans" Margin="0,4,0,0" />
          <ItemsControl x:Name="OrphanList" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ── 主面板 ─────────────────────────────────────── -->
    <DockPanel Grid.Column="1" Background="{DynamicResource Bg}">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
        <StackPanel>
          <TextBlock x:Name="PanelKind" Text="部门" FontSize="11.5" Foreground="{DynamicResource Accent}" />
          <TextBlock x:Name="PanelTitle" Text="还没有内容" FontSize="19" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" Margin="0,3,0,0" />
          <TextBlock x:Name="PanelSub" Text="先在左侧建一个部门，再加几位员工"
                     FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
        <DockPanel>
          <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Primary}"
                  Content="发送" Click="OnSend" Margin="8,0,0,0" Padding="16,7" />
          <!-- 小箭头：字大一点、按钮窄一点 -->
          <Button x:Name="SendModeArrow" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                  Content="▾" Click="OnShowSendModeMenu" Margin="6,0,0,0"
                  Width="24" Height="32" FontSize="16" VerticalAlignment="Center"
                  ToolTip="选择发送方式（Enter / Alt+Enter）" />
          <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="140"
                   VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKeyDown" />
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="StreamScroll" VerticalScrollBarVisibility="Auto" Padding="24,16">
        <ItemsControl x:Name="MessageList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,12" Padding="13,10" CornerRadius="12"
                      Background="{Binding Bubble}" BorderBrush="{Binding BubbleLine}" BorderThickness="1"
                      HorizontalAlignment="{Binding Align}" MaxWidth="720">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="{Binding When}" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Model}" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="8,0,0,0"
                               Visibility="{Binding ModelVisibility}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding TextColor}"
                             LineHeight="21" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- @ 提及候选 -->
    <Popup x:Name="MentionPopup" Placement="Top" PlacementTarget="{Binding ElementName=InputBox}"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="10" Padding="6" Margin="0,0,0,8" MinWidth="280" MaxWidth="380">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
          <StackPanel x:Name="MentionPanel" />
        </ScrollViewer>
      </Border>
    </Popup>
  </Grid>
</Window>
