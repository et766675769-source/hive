<Window x:Class="Hive.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="蜂群 HIVE" Height="840" Width="1320"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface2}"
        Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
  <shell:WindowChrome.WindowChrome>
    <!-- 无系统标题栏：自己画一条；留 6px 边缘用来拖拽缩放 -->
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Button / TextBox 的圆角样式已经搬到 App.xaml（全局），这样设置窗口、表单弹窗也吃得到 -->

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,8" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 标题栏上的窗口按钮：圆角，关闭键 hover 变红 -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E5484D" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ── 自定义标题栏（无系统边框时自己画）──────────────── -->
    <Border x:Name="TitleBar" Grid.Row="0"
            Background="{DynamicResource Surface2}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseDown">
      <DockPanel Height="38">
        <Button x:Name="CloseWindowButton" DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}"
                Content="✕" Click="OnCloseWindow" Margin="6,0,8,0" VerticalAlignment="Center"
                ToolTip="关闭（收进托盘后台运行）" />
        <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                Content="□" Click="OnToggleMaximize" VerticalAlignment="Center" ToolTip="最大化 / 还原" />
        <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                Content="—" Click="OnMinimizeWindow" VerticalAlignment="Center" ToolTip="最小化" />

        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image x:Name="TitleIcon" Width="18" Height="18" Margin="0,0,8,0" />
          <TextBlock Text="蜂群 HIVE" FontSize="12.5" Foreground="{DynamicResource Ink2}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── 主体 ──────────────────────────────────────────── -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="276" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧栏 -->
      <DockPanel Grid.Column="0" Background="{DynamicResource Surface2}">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
          <DockPanel>
            <Button x:Name="AppSettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Width="36" Height="36"
                    Click="OnOpenAppSettings" ToolTip="设置（开机启动 / 存储位置 / 全局 API / 主题）"
                    VerticalAlignment="Center">
              <Image x:Name="SettingsIcon" Width="24" Height="24" Stretch="Uniform" />
            </Button>
            <StackPanel Orientation="Horizontal">
              <Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,10,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="蜂群 HIVE" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" />
                <TextBlock Text="AI 员工面板" FontSize="11.5" Foreground="{DynamicResource Ink3}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
          <Button x:Name="AddProjectButton" Content="新建项目" Click="OnAddProject" Margin="0,0,0,6" />
          <Button x:Name="AddDepartmentButton" Content="新建部门" Click="OnAddDepartment" Margin="0,0,0,6" />
          <Button x:Name="AddEmployeeButton" Content="添加员工" Click="OnAddEmployee" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,10,10,0">
          <StackPanel>
            <TextBlock Text="项目" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                       Margin="6,0,0,6" />
            <ItemsControl x:Name="ProjectList" />
            <TextBlock x:Name="ProjectEmpty" Text="还没有项目" FontSize="12" Foreground="{DynamicResource Ink3}"
                       Margin="10,0,0,12" />

            <TextBlock Text="部门" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                       Margin="6,8,0,6" />
            <ItemsControl x:Name="DepartmentList" />
            <Button x:Name="OrphanHeader" Content="未分配部门" HorizontalContentAlignment="Left"
                    Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource Ink3}" Click="OnToggleOrphans" Margin="0,4,0,0" />
            <ItemsControl x:Name="OrphanList" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- 主面板 -->
      <DockPanel Grid.Column="1" Background="{DynamicResource Bg}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
          <DockPanel>
            <!-- 右上角：导出本面板全部对话 / 清空本面板记录 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="ExportThreadButton" Content="导出对话" Click="OnExportThread"
                      Padding="12,6" FontSize="12" ToolTip="把本面板的全部对话导出成 Markdown 文件" />
              <Button x:Name="ClearThreadButton" Content="清空记录" Click="OnClearThread"
                      Padding="12,6" FontSize="12" Margin="8,0,0,0"
                      Foreground="{DynamicResource Danger}" BorderBrush="{DynamicResource DangerLine}"
                      ToolTip="清空本面板的全部对话（不可恢复）" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="PanelKind" Text="部门" FontSize="11.5" Foreground="{DynamicResource Accent}" />
              <TextBlock x:Name="PanelTitle" Text="还没有内容" FontSize="19" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink}" Margin="0,3,0,0" />
              <TextBlock x:Name="PanelSub" Text="先在左侧建一个部门，再加几位员工"
                         FontSize="12.5" Foreground="{DynamicResource Ink2}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
          <DockPanel>
            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Primary}"
                    Content="发送" Click="OnSend" Margin="8,0,0,0" Padding="16,7" />
            <Button x:Name="SendModeArrow" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    Content="▾" Click="OnShowSendModeMenu" Margin="6,0,0,0"
                    Width="24" Height="32" FontSize="16" VerticalAlignment="Center"
                    ToolTip="选择发送方式（Enter / Alt+Enter）" />
            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKeyDown" />
          </DockPanel>
        </Border>

        <Grid>
          <ScrollViewer x:Name="StreamScroll" VerticalScrollBarVisibility="Auto" Padding="24,16"
                        ScrollChanged="OnStreamScrollChanged">
            <ItemsControl x:Name="MessageList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,14" HorizontalAlignment="{Binding Align}">
                    <!-- 发言人头像：只有员工有，"你"自己的消息不显示 -->
                    <ContentPresenter Content="{Binding Avatar}" Visibility="{Binding AvatarVisibility}"
                                      VerticalAlignment="Top" Margin="0,2,10,0" />
                    <Border Padding="13,10" CornerRadius="12" MaxWidth="640"
                            Background="{Binding Bubble}" BorderBrush="{Binding BubbleLine}" BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="12.5"
                                     Foreground="{DynamicResource Ink}" />
                          <TextBlock Text="{Binding When}" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="8,0,0,0" />
                          <TextBlock Text="{Binding Model}" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="8,0,0,0"
                                     Visibility="{Binding ModelVisibility}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding TextColor}"
                                   LineHeight="21" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 上滑看历史时不再被拽回底部，改为显示这个按钮 -->
          <Button x:Name="JumpLatestButton" Content="↓ 回到最新" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                  Padding="14,7" FontSize="12" Click="OnJumpToLatest"
                  ToolTip="有新消息，点一下跳到最新" />
        </Grid>
      </DockPanel>
    </Grid>

    <!-- @ 提及候选：列出当前对话里的所有人 -->
    <Popup x:Name="MentionPopup" Placement="Top" PlacementTarget="{Binding ElementName=InputBox}"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="10" Padding="6" Margin="0,0,0,8" MinWidth="280" MaxWidth="380">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
          <StackPanel x:Name="MentionPanel" />
        </ScrollViewer>
      </Border>
    </Popup>
  </Grid>
</Window>
