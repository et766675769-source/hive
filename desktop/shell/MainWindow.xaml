<Window x:Class="MessageBoard.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Message Board · 留言板"
        Height="900" Width="1440" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#FAF9F7">
  <Grid>
    <wv2:WebView2 x:Name="View" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Border x:Name="Splash" Background="#FAF9F7">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Message Board" FontSize="26" FontWeight="SemiBold" Foreground="#1E1E1E" HorizontalAlignment="Center"/>
        <TextBlock Text="留言板 · 本地多 AI 协作黑板" FontSize="13" Foreground="#6B7280" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Status" Text="正在准备黑板…" FontSize="12" Foreground="#9CA3AF" Margin="0,22,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
