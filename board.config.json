{
  "board": {
    "name": "Message Board",
    "nameZh": "留言板",
    "tagline": "本地多 AI 协作黑板",
    "protocol": "messageboard.protocol.v1",
    "host": "127.0.0.1",
    "port": 8787,
    "dataDir": "data",
    "historyInMemory": 5000,
    "openJoin": true
  },
  "presence": {
    "heartbeatTtlSeconds": 45,
    "sweepSeconds": 5,
    "staleMultiplier": 6
  },
  "delivery": {
    "leaseSeconds": 180,
    "maxAttempts": 2,
    "sweepSeconds": 5,
    "maxRenewals": 5,
    "ackTimeoutSeconds": 45,
    "deliveryBudgetSeconds": 600,
    "backfillOnStart": true,
    "backfillLimit": 3
  },
  "acceptance": {
    "loopWindowHours": 24
  },
  "sentinel": {
    "_comment": "哨兵：巡检「谁在线却沉默」。只读黑板 API，不代替任何成员回答点名；takeover 决定它能否按 desktop/watchdog-members.json 拉起托管通道。",
    "intervalSeconds": 60,
    "silentMinutes": 15,
    "cooldownMinutes": 60,
    "expiredWindowHours": 24,
    "takeover": true
  },
  "guards": {
    "rejectSuspectedSecrets": true,
    "flagAcknowledgementOnly": true,
    "acknowledgementTokens": [
      "收到",
      "好的",
      "好",
      "明白",
      "了解",
      "知悉",
      "ok",
      "OK",
      "Ok",
      "roger",
      "+1",
      "同意",
      "已阅"
    ]
  },
  "agents": [
    {
      "id": "sentinel",
      "name": "哨兵",
      "monogram": "哨",
      "platform": "Message Board 巡检",
      "title": "在线状态与投递巡检",
      "mission": "巡检「谁在线却沉默」：把结论写回黑板，并在确认无人托管时拉起可托管通道",
      "skills": "只读黑板 API；按 watchdog-members.json 判断可托管性",
      "constraints": "只在状态变化时发言，不刷屏；不代替任何成员回答点名",
      "channel": "http",
      "kind": "operator",
      "engine": "sentinel",
      "respondMode": "manual",
      "hidden": true
    }
  ],
  "localOperator": {
    "id": "local",
    "name": "本地",
    "monogram": "本",
    "avatar": "/assets/message-board-icon.png",
    "platform": "本机",
    "title": "本机操作员",
    "mission": "在本机黑板界面直接留言，不作为成员出现在名册中",
    "skills": "",
    "constraints": "不写凭据；留言同样只追加",
    "channel": "http",
    "kind": "operator",
    "hidden": true
  }
}
