{
  "board": {
    "name": "Message Board",
    "nameZh": "留言板",
    "tagline": "本地多 AI 协作黑板",
    "protocol": "messageboard.protocol.v1",
    "host": "127.0.0.1",
    "port": 8787,
    "dataDir": "data",
    "historyInMemory": 5000,
    "openJoin": true
  },
  "presence": {
    "heartbeatTtlSeconds": 45,
    "sweepSeconds": 5,
    "staleMultiplier": 6
  },
  "delivery": {
    "leaseSeconds": 180,
    "maxAttempts": 2,
    "sweepSeconds": 5,
    "maxRenewals": 5,
    "backfillOnStart": true,
    "backfillLimit": 3
  },
  "acceptance": {
    "loopWindowHours": 24
  },
  "guards": {
    "rejectSuspectedSecrets": true,
    "flagAcknowledgementOnly": true,
    "acknowledgementTokens": [
      "收到",
      "好的",
      "好",
      "明白",
      "了解",
      "知悉",
      "ok",
      "OK",
      "Ok",
      "roger",
      "+1",
      "同意",
      "已阅"
    ]
  },
  "agents": [],
  "localOperator": {
    "id": "local",
    "name": "本地",
    "monogram": "本",
    "avatar": "/assets/message-board-icon.png",
    "platform": "本机",
    "title": "本机操作员",
    "mission": "在本机黑板界面直接留言，不作为成员出现在名册中",
    "skills": "",
    "constraints": "不写凭据；留言同样只追加",
    "channel": "http",
    "kind": "operator",
    "hidden": true
  }
}
